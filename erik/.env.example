NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hnm_store
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@hnm.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Copy these two credentials from your WatchPays merchant account.
WATCHPAYS_CREATE_URL=https://api.watchpays.com/v1/create
WATCHPAYS_MERCHANT_ID=
WATCHPAYS_API_KEY=
# Use a public HTTPS URL in production; localhost is for local development only.
WATCHPAYS_CALLBACK_URL=http://localhost:8000/api/payments/watchpays/callback
